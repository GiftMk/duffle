{
	"name": "@duffle/rpc",
	"version": "1.0.50",
	"type": "module",
	"exports": {
		".": "./src/exports.ts",
		"./migrations": "./migrations.json"
	},
	"scripts": {
		"predev": "bun run db:push",
		"dev": "bun run --hot src/index.ts",
		"migrate": "bunx drizzle-kit generate",
		"postmigrate": "bun run compile-migrations.ts"
	},
	"dependencies": {
		"@electric-sql/pglite": "^0.5.1",
		"@electric-sql/pglite-pgvector": "^0.0.2",
		"@elysiajs/cors": "^1.4.2",
		"@t3-oss/env-core": "^0.13.11",
		"drizzle-orm": "^0.45.2",
		"from": "^0.1.7",
		"import": "^0.0.6",
		"pg": "^8.20.0",
		"remark": "^15.0.1",
		"strip-markdown": "^6.0.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/pg": "^8.20.0",
		"bun-types": "latest",
		"drizzle-kit": "^0.31.10"
	},
	"module": "src/index.js"
}
