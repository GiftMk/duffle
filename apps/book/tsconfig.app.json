{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"target": "es2023",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "esnext",
		"types": ["vite/client", "node"],
		"skipLibCheck": true,
		"erasableSyntaxOnly": true,

		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src"]
}
