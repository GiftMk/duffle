{
	"module": "index.ts",
	"type": "module",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "concurrently -c \"blue,magenta\" -n \"API,WWW\" \"bun --elide-lines=0 --filter ./apps/api dev\" \"bun --elide-lines=0 --filter ./apps/www dev\"",
		"db": "psql -d duffle",
		"tidy": "biome check --write --unsafe ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.4",
		"@types/bun": "latest",
		"concurrently": "^9.2.1"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.2.2",
		"framer-motion": "^12.38.0",
		"tailwindcss": "^4.2.2"
	}
}
