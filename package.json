{
	"type": "module",
	"private": true,
	"packageManager": "pnpm@10.20.0",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "pnpm --parallel --filter @duffle/kanban --filter @duffle/notes dev",
		"dev:kanban": "pnpm --filter @duffle/kanban dev",
		"dev:notes": "pnpm --filter @duffle/notes dev",
		"tidy": "pnpm -r --if-present run tidy",
		"tsc": "pnpm -r --if-present run tsc",
		"test": "pnpm -r --if-present run test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.4"
	},
	"peerDependencies": {
		"typescript": "~6.0.3"
	}
}
